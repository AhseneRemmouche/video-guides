{
  "name": "agentic-week1-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript + React port of Week 1 (Foundations) of Ed Donner's Agentic AI Engineering course",
  "scripts": {
    "day1": "tsx src/day1.ts",
    "day2": "tsx src/day2.ts",
    "day3": "tsx src/day3.ts",
    "day4": "tsx src/day4.ts",
    "career": "tsx src/career.ts",
    "api": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "marked": "^18.1.2",
    "openai": "^7.45.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
