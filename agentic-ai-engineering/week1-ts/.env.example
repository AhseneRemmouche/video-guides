# Required for every lab and for the career chat API.
OPENAI_API_KEY=sk-proj-...

# Optional - Day 2 talks to several providers through the same OpenAI client
# by only changing baseURL + apiKey (the "OpenAI-compatible" trick).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional - the career agent sends a phone push when a tool fires.
# Without these the push() call is a harmless no-op.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Local mode (no OpenAI key): point the client at Ollama instead.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
