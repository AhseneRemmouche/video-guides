# Week 1 (Foundations) - LOCAL Ollama config. Copy to .env (optional; these are the defaults).
#
# The course uses paid frontier models (OpenAI/Anthropic/etc.) + a real Pushover account.
# This project runs entirely against a LOCAL Ollama server, so NO paid API keys are needed.
#
# Ollama exposes an OpenAI-compatible endpoint. The api_key value is ignored by Ollama
# but the OpenAI SDK requires *some* string, so we use the literal "ollama".

OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# Models (must already be pulled: `ollama pull llama3.2` and `ollama pull dolphin3:8b`)
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_2=dolphin3:8b
