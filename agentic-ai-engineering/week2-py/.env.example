# This project runs the OpenAI Agents SDK against a LOCAL Ollama server.
# No real OpenAI key is needed. The "api_key" is a dummy string Ollama ignores.

# Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Dummy key - Ollama does not check it, but the OpenAI client requires something non-empty
OPENAI_API_KEY=ollama

# The local model to use (must be pulled in Ollama: `ollama pull llama3.2`)
OLLAMA_MODEL=llama3.2
