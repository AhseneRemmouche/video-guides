{
  "name": "agentic-week4-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript + React port of Week 4 (LangGraph.js) of Ed Donner's Agentic AI Engineering course",
  "scripts": {
    "day1": "tsx src/day1.ts",
    "day2": "tsx src/day2.ts",
    "day3": "tsx src/day3.ts",
    "day4": "tsx src/day4.ts",
    "sidekick": "tsx src/run.ts",
    "api": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.44",
    "@langchain/openai": "^0.4.4",
    "dotenv": "^16.4.7",
    "hono": "^4.6.19",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
