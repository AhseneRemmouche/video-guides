# Local Ollama (default - no key, no cost). These are the defaults in src/model.ts,
# so you do not even need a .env to run locally.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.2

# To use real OpenAI instead:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-proj-...
# MODEL=gpt-4o-mini

# Optional: a real Serper web-search key enables the web_search tool (otherwise it is a stub).
SERPER_API_KEY=

# Port for the Hono API (defaults to 8787).
PORT=8787
