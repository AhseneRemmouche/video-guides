{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Stock picker crew (stock_picker.main)",
      "type": "debugpy",
      "request": "launch",
      "module": "stock_picker.main",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
