{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run the world (uv run world.py)",
      "type": "shell",
      "command": "uv run world.py",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Install packages (uv sync)",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "Clear the generated agents and ideas",
      "type": "shell",
      "command": "rm -f agent[0-9]*.py idea*.md",
      "options": {
        "shell": { "executable": "/bin/sh", "args": ["-c"] }
      },
      "windows": {
        "command": "Remove-Item agent[0-9]*.py, idea*.md",
        "options": {
          "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
        }
      },
      "problemMatcher": []
    }
  ]
}
