{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scheduler (trading_floor.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/trading_floor.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Dashboard (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Reset the traders (reset.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reset.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Trading floor: scheduler + dashboard",
      "configurations": ["Scheduler (trading_floor.py)", "Dashboard (app.py)"],
      "stopAll": true
    }
  ]
}
