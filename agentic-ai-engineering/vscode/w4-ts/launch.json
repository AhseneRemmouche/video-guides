{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (npm run api)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web dev server (npm run web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Sidekick in the terminal (npm run sidekick)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run sidekick -- \"What is 17 * 23? Use the calculator.\" \"The reply states 391.\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "React page in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full app: API + web",
      "configurations": ["API server (npm run api)", "Web dev server (npm run web)"],
      "stopAll": true
    }
  ]
}
