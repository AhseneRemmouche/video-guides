# Local Ollama routing (used by LiteLLM inside CrewAI).
OLLAMA_API_BASE=http://localhost:11434

# Dummy — nothing paid is called; keeps OpenAI client construction from crashing.
OPENAI_API_KEY=sk-local-ollama-not-used

# Crew memory on/off (default on). Set to 0 to run without memory.
STOCK_PICKER_MEMORY=1
# Local embedding model used by short-term/entity memory (via Ollama).
STOCK_PICKER_EMBED_MODEL=nomic-embed-text

# NOT USED in this local build (the course needs these for the real services):
#   SERPER_API_KEY=...        # Serper.dev web search  -> replaced by an offline stub
#   PUSHOVER_USER=...         # Pushover push notifs    -> replaced by a stdout log
#   PUSHOVER_TOKEN=...
