# Local Ollama (default - no key, no cost). These are the defaults in common.py,
# so you do not even need a .env to run locally.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=llama3.2

# To use real OpenAI instead, set a real key and a hosted model:
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-proj-...
# MODEL=gpt-4o-mini

# lab3: use the file-backed SQLite checkpointer instead of in-memory.
# CHECKPOINTER=sqlite
