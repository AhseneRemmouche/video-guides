# The OpenAI Agents SDK talks to the OpenAI Responses API and uploads traces to platform.openai.com.
OPENAI_API_KEY=sk-proj-...

# Model used by every agent (defaults to gpt-4o-mini, like the course).
MODEL=gpt-4o-mini

# How many web searches the planner should request (deep research). Defaults to 3.
HOW_MANY_SEARCHES=3

# Optional: send the research email for real via SendGrid. Without a key the email is printed instead.
SENDGRID_API_KEY=
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# Optional (day3): other OpenAI-compatible providers.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional local mode (no OpenAI key): point the SDK at an Ollama server and switch tracing off.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL=llama3.2
