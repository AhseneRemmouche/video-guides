OPENAI_API_KEY=sk-proj-...
# optional, as in the course
# without POLYGON_API_KEY, market.ts uses STAND-IN prices (fake, not market data); POLYGON_PLAN=paid or realtime
# switches the trader to Polygon's own MCP server
POLYGON_API_KEY=
POLYGON_PLAN=
# without BRAVE_API_KEY the Brave search server is skipped
BRAVE_API_KEY=
# without both Pushover values, push notifications are only printed
PUSHOVER_USER=
PUSHOVER_TOKEN=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
# trading floor settings
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=false
# not in the course: one round, then exit
# RUN_ONCE=true
# behind a company proxy or antivirus TLS scanner, uvx may need this (passed on to MCP servers, see src/setup.ts)
# UV_SYSTEM_CERTS=true
# local mode (no OpenAI key): uncomment
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL=llama3.2
