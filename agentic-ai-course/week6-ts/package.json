{
  "name": "agentic-ai-week6-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript port of Week 6 (MCP and the autonomous trading floor) of The Complete Agentic AI Engineering Course, plus a React trading-floor dashboard",
  "scripts": {
    "lab1": "tsx src/lab1.ts",
    "lab2": "tsx src/lab2.ts",
    "lab3": "tsx src/lab3.ts",
    "lab4": "tsx src/lab4.ts",
    "count-tools": "tsx src/count_tools.ts",
    "accounts-server": "tsx src/accounts_server.ts",
    "mcp-check": "tsx src/mcp_check.ts",
    "reset": "tsx src/reset.ts",
    "seed-demo": "tsx src/seed_demo.ts",
    "trading-floor": "tsx src/trading_floor.ts",
    "api": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openai/agents": "0.20.0",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "openai": "^7.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
