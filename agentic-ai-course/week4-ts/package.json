{
  "name": "agentic-ai-week4-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript port of Week 4 (LangGraph) of The Complete Agentic AI Engineering Course, plus a React Sidekick app",
  "scripts": {
    "lab1": "tsx src/lab1.ts",
    "lab2": "tsx src/lab2.ts",
    "lab3": "tsx src/lab3.ts",
    "lab4": "tsx src/lab4.ts",
    "sidekick": "tsx src/sidekick/cli.ts",
    "api": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.6.2",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
