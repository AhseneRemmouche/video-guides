# Copy this file to .env and fill in what you use. Never commit .env.

# Which chat model the graphs use: openai (default, like the course) or ollama (local, free)
MODEL_PROVIDER=openai

# OpenAI (MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (MODEL_PROVIDER=ollama): install Ollama, then `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2

# Optional: send traces to LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=LangGraph_ACL
