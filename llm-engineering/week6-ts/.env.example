# Week 6 - The product pricer (estimate a price from a description).

# OpenAI API key (needed to actually call the model).
OPENAI_API_KEY=sk-proj-...

# The model that does the estimating. After Week 6 you point this at your own
# fine-tuned model id (e.g. ft:gpt-4o-mini-2024-07-18:...); until then it falls
# back to the base gpt-4o-mini.
# FINE_TUNED_MODEL=ft:gpt-4o-mini-2024-07-18:personal::XXXXXXXX

# Optional: port the Hono API off the default 8788
# PORT=8788
