# Week 3 runs open-source models locally via transformers.js, so no API key is needed
# for the labs, the API or the web app. Models download from the HuggingFace hub on
# first use and are cached under node_modules/.cache.

# Optional: a HuggingFace token lets you reach gated/private repos and raises rate limits.
HF_TOKEN=

# Optional: override the API port (defaults to 8789).
# PORT=8789
