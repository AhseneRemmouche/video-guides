# Week 2 runs entirely against a LOCAL Ollama server (free, no cloud keys needed).
# Copy this file to .env and adjust if your Ollama is not on the default host/port.

# Ollama exposes an OpenAI-compatible endpoint at /v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# The api_key is ignored by Ollama but the OpenAI SDK requires a non-empty value.
OLLAMA_API_KEY=ollama

# Default local model (maps to llama3.2:latest in Ollama)
MODEL=llama3.2

# A second local model used for the adversarial two-model conversation in day1.
# NOTE: On this server qwen3.5:9b is listed by Ollama but fails to load
# ("not found, try pulling it first"), so we use a known-good second model.
MODEL_B=dolphin3:8b
