{
  "name": "llmeng-week8-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript + React dashboard demo for Week 8 of Ed Donner's LLM Engineering course (The Price is Right - an autonomous multi-agent deal-hunting system). Sample data only; the real agent pipeline is Python.",
  "scripts": {
    "deals": "tsx src/deals.cli.ts",
    "api": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
