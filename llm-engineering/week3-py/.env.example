# Week 3 is open-source / HuggingFace. None of the CPU demos here require a key.
#
# An HF token is only needed to download GATED models (e.g. Meta's Llama 3.1,
# which the course uses on a GPU in Colab). The CPU demos deliberately use
# UNGATED models (gpt2, distilbart, Qwen2-0.5B) so no token is required.
#
# If you later want to pull a gated model, create a token at
# https://huggingface.co/settings/tokens and set:
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: keep model downloads inside the project instead of ~/.cache.
# HF_HOME=./.hf-cache
