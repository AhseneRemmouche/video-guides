{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Syntax-check the open file (py_compile)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "py_compile", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Syntax-check all three scripts (py_compile)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m", "py_compile",
        "src/day1_setup.py",
        "src/day3_4_train.py",
        "src/day5_evaluate.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "GPU machine: run day1_setup.py",
      "type": "shell",
      "command": "uv run --no-sync python src/day1_setup.py",
      "problemMatcher": []
    },
    {
      "label": "GPU machine: train (day3_4_train.py)",
      "type": "shell",
      "command": "uv run --no-sync python src/day3_4_train.py",
      "problemMatcher": []
    },
    {
      "label": "GPU machine: evaluate (day5_evaluate.py)",
      "type": "shell",
      "command": "uv run --no-sync python src/day5_evaluate.py",
      "problemMatcher": []
    }
  ]
}
