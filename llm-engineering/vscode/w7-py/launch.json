{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Day 1-2: setup (GPU machine)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day1_setup.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Day 3-4: train (GPU machine)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day3_4_train.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Day 5: evaluate (GPU machine)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day5_evaluate.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
