{
  "python.terminal.activateEnvironment": true,
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "information",
    "reportMissingModuleSource": "information"
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/pricer-*/**": true,
    "**/wandb/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "uv.lock": true,
    "**/pricer-*": true,
    "**/wandb": true
  }
}
