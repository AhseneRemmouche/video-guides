{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (npm run api)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web dev server (npm run web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pricer in the terminal (npm run price)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run price -- \"Noise-cancelling over-ear bluetooth headphones, 30h battery\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "React page in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full app: API + web",
      "configurations": [
        "API server (npm run api)",
        "Web dev server (npm run web)"
      ],
      "stopAll": true
    }
  ]
}
