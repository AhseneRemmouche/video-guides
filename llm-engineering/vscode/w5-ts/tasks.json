{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: Hono server on :8788",
      "type": "npm",
      "script": "api",
      "problemMatcher": []
    },
    {
      "label": "web: React page on :5173",
      "type": "npm",
      "script": "web",
      "problemMatcher": []
    },
    {
      "label": "dev: api + web together",
      "dependsOn": [
        "api: Hono server on :8788",
        "web: React page on :5173"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "ingest: load, split and embed knowledge/",
      "type": "npm",
      "script": "ingest",
      "problemMatcher": []
    },
    {
      "label": "ask: one question in the terminal",
      "type": "shell",
      "command": "npm run ask -- \"${input:question}\"",
      "problemMatcher": []
    },
    {
      "label": "typecheck",
      "type": "npm",
      "script": "typecheck",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "build: type-check + bundle the page",
      "type": "npm",
      "script": "build",
      "problemMatcher": [
        "$tsc"
      ]
    }
  ],
  "inputs": [
    {
      "id": "question",
      "type": "promptString",
      "description": "Your question for the knowledge base",
      "default": "How much does Carllm cost?"
    }
  ]
}
