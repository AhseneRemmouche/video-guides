{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (npm run api)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web dev server (npm run web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ingest in the terminal (npm run ingest)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run ingest",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ask in the terminal (npm run ask)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run ask -- \"How much does Carllm cost?\"",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "React page in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full app: API + web",
      "configurations": [
        "API server (npm run api)",
        "Web dev server (npm run web)"
      ],
      "stopAll": true
    }
  ]
}
