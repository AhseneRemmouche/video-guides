{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Day 1: three providers (npm run day1)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Day 3: chatbot (npm run day3)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day3",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Day 4: tools (npm run day4)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day4",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Day 5: image and speech (npm run day5)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day5",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "API server (npm run api)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web dev server (npm run web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "React page in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full app: API + web",
      "configurations": [
        "API server (npm run api)",
        "Web dev server (npm run web)"
      ],
      "stopAll": true
    }
  ]
}
