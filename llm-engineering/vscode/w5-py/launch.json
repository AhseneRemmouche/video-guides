{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ingest (src/ingest.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/ingest.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Ask: Carllm price (src/rag.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/rag.py",
      "args": [
        "How much does the Carllm product cost per month?"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
