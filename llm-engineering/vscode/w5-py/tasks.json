{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ingest: build chroma_db (uv run python src/ingest.py)",
      "type": "shell",
      "command": "uv run python src/ingest.py",
      "problemMatcher": []
    },
    {
      "label": "Ask a question (uv run python src/rag.py)",
      "type": "shell",
      "command": "uv run python src/rag.py \"${input:question}\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Check the Ollama models (ollama list)",
      "type": "shell",
      "command": "ollama list",
      "problemMatcher": []
    },
    {
      "label": "Install packages (uv sync)",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "question",
      "type": "promptString",
      "description": "Your question for the knowledge base",
      "default": "How much does the Carllm product cost per month?"
    }
  ]
}
