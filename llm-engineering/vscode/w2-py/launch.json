{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Day 1: two models (day1_apis.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day1_apis.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Day 3: chatbot (day3_chatbot.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day3_chatbot.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Day 4: tools (day4_tools.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/day4_tools.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
