{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (npm run api)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run api",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Web dev server (npm run web)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run web",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Day 2 lab (npm run day2)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day2",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Day 3 lab (npm run day3)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run day3",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "React page in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5174",
      "webRoot": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "Full app: API + web",
      "configurations": ["API server (npm run api)", "Web dev server (npm run web)"],
      "stopAll": true
    }
  ]
}
