{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Deal pipeline (planning_agent.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/planning_agent.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pricer alone (pricer_agent.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/pricer_agent.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: the file that is open",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
