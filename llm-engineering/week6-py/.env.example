# Local Ollama acts as an OpenAI-compatible endpoint for the frontier_eval step.
# Copy this file to .env (or just export these) if you want to override the defaults.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2:latest

# TLS note: if `uv sync` fails with a certificate error on your machine, set:
# UV_NATIVE_TLS=1
