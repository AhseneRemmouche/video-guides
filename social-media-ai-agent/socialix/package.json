{
  "name": "social-media-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Socialix: a team of Claude agents (Master, Research, Creator, Scheduler, Analytics) that plans, writes and schedules social posts, publishing through the WordPress Social Autopilot via an MCP server",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "mcp:social": "tsx mcp/social-publisher/server.ts",
    "mcp:check": "tsx scripts/mcp-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": { "onlyBuiltDependencies": ["sharp", "esbuild", "@tailwindcss/oxide", "unrs-resolver"] }
}
