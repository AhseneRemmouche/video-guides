# Copy to .env and edit. The defaults below use a local Ollama server (no key, no cost).
AIE_BASE_URL=http://localhost:11434/v1
AIE_API_KEY=ollama
AIE_MODEL=llama3.2
AIE_JUDGE_MODEL=gemma4
AIE_REASONING_EFFORT=none
AIE_EMBED_MODEL=nomic-embed-text

# To use OpenAI instead, replace the lines above with:
# AIE_BASE_URL=https://api.openai.com/v1
# AIE_API_KEY=sk-...your key...
# AIE_MODEL=gpt-5-mini
# AIE_JUDGE_MODEL=gpt-5
# AIE_REASONING_EFFORT=minimal
# AIE_EMBED_MODEL=text-embedding-3-small
