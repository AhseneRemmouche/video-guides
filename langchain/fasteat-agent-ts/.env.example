# Copy this file to .env and fill in what you use. Never commit .env.

# Which models to use: openai (default, like the course) or ollama (free, runs on your computer).
MODEL_PROVIDER=openai

# OpenAI (MODEL_PROVIDER=openai). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano

# Ollama (MODEL_PROVIDER=ollama). No key; run `ollama pull llama3.2` and `ollama pull gemma4` first.
# OLLAMA_MODEL=llama3.2          text model (lessons 04-10)
# OLLAMA_VISION_MODEL=gemma4     model that can see photos (lesson 11, the chef, the web app)

# Tavily web search (optional). Without it the search tool answers
# "Web search is not configured (no TAVILY_API_KEY)" and the agent carries on.
TAVILY_API_KEY=

# chef/main-any-model.ts only: any "provider:model" string, e.g. openai:gpt-5-nano or ollama:gemma4
# CHEF_MODEL=openai:gpt-5-nano
